manifest {
    name            = 'lifebit-immunedeconv-nf'
    author          = 'Your Name'
    homePage        = 'https://github.com/OpenOmics/lifebit-immunedeconv-nf'
    description     = 'CD4/CD8 T-cell deconvolution of bulk RNA-seq using immunedeconv'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '0.1.0'
}

params {
    // ---- Inputs -----------------------------------------------------
    input   = null
    outdir  = 'results'
    methods = 'quantiseq,epic,mcp_counter'
    species = 'human'
    tumor   = false
    arrays  = false

    // ---- Optional CIBERSORT (user-supplied, not in container) -------
    cibersort_binary = null
    cibersort_mat    = null

    // ---- Container ---------------------------------------------------
    // Default to :latest for convenience; override with a git SHA or
    // semver tag (e.g. --container_tag e9c1f2a) on cloud executors like
    // AWS Batch where :latest can be cached stale across hosts.
    container_repo = 'ghcr.io/openomics/lifebit-immunedeconv-nf'
    container_tag  = 'latest'

    // ---- Resource caps (lifebit/CloudOS-friendly) --------------------
    max_cpus   = 8
    max_memory = '16.GB'
    max_time   = '4.h'
}

// Resolved container image reference, used by every process
process.container = "${params.container_repo}:${params.container_tag}"

profiles {
    standard    { includeConfig 'conf/base.config' }
    docker      { includeConfig 'conf/docker.config' }
    singularity { includeConfig 'conf/singularity.config' }
    test        { includeConfig 'conf/test.config' }
}

// Reporting
timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag.svg" }
